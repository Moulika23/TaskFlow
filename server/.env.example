# Server-side environment variables
# Copy this file to .env and fill in your real values
# NEVER commit the .env file to GitHub

PORT=5000

# Option 1: Local MongoDB (development) — MongoDB must be installed and running
MONGO_URI=mongodb://localhost:27017/taskflow

# Option 2: MongoDB Atlas (production) — replace with your Atlas connection string
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority

JWT_SECRET=your_super_secret_key_here_make_it_long_and_random
